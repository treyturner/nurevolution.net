[Unit]
Description=nurevolution encrypted MinIO backup
After=network-online.target
Wants=network-online.target
OnFailure=nurevolution-backup-alert.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nurevolution/backup.env
ExecStart=/usr/bin/python3 /usr/local/lib/nurevolution/bootstrap.py backup
Nice=10
IOSchedulingClass=idle
MemoryMax=192M
TasksMax=64
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/nurevolution/state /srv/nurevolution/tooling /srv/edge/config /var/cache/nurevolution-restic

[Install]
WantedBy=multi-user.target
