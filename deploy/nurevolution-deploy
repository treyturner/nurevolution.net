#!/usr/bin/env bash
set -euo pipefail
bootstrap=/usr/local/lib/nurevolution/bootstrap.py
if [[ ! -f "$bootstrap" ]]; then
  echo 'Install the versioned tooling bootstrap: docs/operations/tooling-bootstrap.md' >&2
  exit 1
fi
if [[ $# == 1 && "$1" == --version ]]; then
  exec python3 "$bootstrap" version
fi
[[ $# == 4 ]]
[[ "$1" == production ]]
[[ "$2" =~ ^[1-9][0-9]*-[1-9][0-9]*$ ]]
[[ "$3" =~ ^[1-9][0-9]*$ ]]
[[ "$4" =~ ^[a-f0-9]{40}$ ]]
exec python3 "$bootstrap" promote "$2" "$3" "$4"
